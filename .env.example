# ========== ITOps Platform 环境变量配置 ==========
# 复制此文件为 .env 后修改

# === 安全（生产环境务必修改） ===
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://itops:itops123@postgres:5432/itops

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === CORS（允许的前端域名，逗号分隔） ===
CORS_ORIGINS=http://localhost:3000

# === LLM API Keys（至少配置一个即可使用 AI 功能） ===
# 智谱 AI（推荐，GLM-4-Flash 免费）→ https://open.bigmodel.cn/
GLM_API_KEY=
# DeepSeek → https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# OpenAI 兼容 → 任何兼容 /v1/chat/completions 的接口
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# === HuggingFace（国内部署建议用镜像） ===
HF_ENDPOINT=https://hf-mirror.com
